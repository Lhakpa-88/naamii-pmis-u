# ---- NAAMII PMIS — environment settings (copy to .env; never commit real values) ----

# Application database connection — the LOW-PRIVILEGE role. Row Level Security applies.
DATABASE_URL=postgres://pmis_app@127.0.0.1:5433/naamii_pmis

# Admin connection used only by migrations/seed scripts (not by the web app).
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5433/naamii_pmis

# Authentication mode:
#   password — sign in with user ID (e-mail) and password; Finance & Operations sets and resets passwords
#   dev   — development/testing: user ID only (Admin, PI, PM, ED or an e-mail), NO password; refused in production
#   demo  — Demo Mode: pick a clearly-labelled fictional user on the sign-in page (local/dev only)
#   entra — Microsoft Entra ID single sign-on via Azure App Service built-in authentication
PMIS_AUTH_MODE=password

# Random secret used to sign the session cookie (any long random string; changing it signs everyone out).
SESSION_SECRET=change-me-to-a-long-random-string

# Show the "DEMO DATA" banner (set to false only when real data is connected).
PMIS_DEMO_BANNER=true

# Optional: passwords applied to the service roles by `npm run db:migrate` (Azure).
# PMIS_APP_PASSWORD=
# PMIS_ETL_PASSWORD=
